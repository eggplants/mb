#!/usr/bin/env bash
#MISE description="Fail unless this machine's env selection (miserc.local.toml) is valid and matches this host"
#MISE hide=true
# Runs before every platform's bootstrap task and before the destructive NanoPi tasks
# (#MISE depends=["host:check"]), so `mise bootstrap --only task`, `mise run bootstrap` and
# `mise run hdd:init` cannot run on the wrong host. `--detect` prints this host's platform.
# The host tests mirror guard.tera and bootstrap.sh (ci/check.sh compares them).
set -euo pipefail
# shellcheck disable=SC1091 # /etc/os-release
if [[ -n "${TERMUX_VERSION:-}" || -x /data/data/com.termux/files/usr/bin/pkg ]]; then
  host=termux
elif [[ "$(uname -s)" == Darwin ]]; then
  host=macos
elif grep -aqsi nanopi /proc/device-tree/model; then
  host=nanopi
elif [[ "$(. /etc/os-release 2>/dev/null && echo "$ID")" == ubuntu ]]; then
  host=ubuntu
else
  host=unknown
fi
if [[ "${1:-}" == --detect ]]; then
  echo "$host"
  exit 0
fi
sel="${MISE_ENV:-}"
case "$sel" in
  macos) want=macos ;;
  termux) want=termux ;;
  linux,ubuntu | linux,ubuntu,desktop) want=ubuntu ;;
  linux,nanopi) want=nanopi ;;
  *)
    echo "host:check: env selection [$sel] is not one of: macos | termux | linux,ubuntu | linux,ubuntu,desktop | linux,nanopi" >&2
    exit 1
    ;;
esac
[[ "$host" == "$want" ]] || {
  echo "host:check: env [$sel] is for $want, but this host is $host" >&2
  exit 1
}
