#!/usr/bin/env bash
#MISE description="Point Claude Code's statusLine at claude-statusbar and install user-scope plugins and MCP servers, also for mclaude"
set -euo pipefail

# user-scope plugin marketplaces (name=source) and plugins (name@marketplace)
marketplaces=(
  claude-community=anthropics/claude-plugins-community
  claude-plugins-official=anthropics/claude-plugins-official
  cursor-plugins=cursor/plugins
  googlechrome=GoogleChrome/modern-web-guidance
  humanize-writing-skill=eggplants/humanize-writing-skill
  yomiyasu=nanaism/yomiyasu
)
plugins=(
  claude-security@claude-plugins-official
  eli5@claude-community
  humanize-writing@humanize-writing-skill
  modern-web-guidance@googlechrome
  pstack@cursor-plugins
  yomiyasu@yomiyasu
)
# user-scope MCP servers (name=command), added only when the command is installed
mcp_servers=(
  'trivy=trivy mcp'
)

# trivy MCP server plugin
if command -v trivy &>/dev/null && ! trivy plugin info mcp &>/dev/null; then
  trivy plugin install mcp
fi

# claude-statusbar
cmd="$(jq -r '.statusLine.command // ""' ~/.claude/settings.json 2>/dev/null || :)"
cmd="${cmd%% *}"
if ! [[ "$cmd" =~ (claude-statusbar|/cs)$ ]] || ! command -v "$cmd" &>/dev/null; then
  claude-statusbar --setup
fi

src=~/.claude/settings.json
dst=~/.mclaude/settings.json
line="$(jq -c '.statusLine' "$src")"
if [[ "$(jq -c '.statusLine' "$dst" 2>/dev/null || :)" != "$line" ]]; then
  mkdir -p "${dst%/*}"
  [[ -s $dst ]] || echo '{}' >"$dst"
  tmp="$(mktemp "$dst.XXXXXX")"
  jq --argjson line "$line" '.statusLine = $line' "$dst" >"$tmp"
  mv "$tmp" "$dst"
fi

# ~/.claude skills and commands that tools install there (claude-statusbar etc.), linked into
# ~/.mclaude; synced/ belongs to the logged-in account
for d in skills commands; do
  mkdir -p ~/.mclaude/"$d"
  for f in ~/.mclaude/"$d"/*; do
    if [[ -L $f && ! -e $f && "$(readlink "$f")" == ~/.claude/* ]]; then
      rm "$f"
    fi
  done
  for f in ~/.claude/"$d"/*; do
    t=~/.mclaude/$d/${f##*/}
    if [[ -e $f && ${f##*/} != synced && ! -e $t && ! -L $t ]]; then
      ln -s "$f" "$t"
    fi
  done
done

# plugins, for claude (default config dir) and mclaude (CLAUDE_CONFIG_DIR=~/.mclaude)
for dir in '' ~/.mclaude; do
  c=(env ${dir:+CLAUDE_CONFIG_DIR="$dir"} claude)
  have="$("${c[@]}" plugin marketplace list --json | jq -r '.[].name')"
  for m in "${marketplaces[@]}"; do
    grep -qxF "${m%%=*}" <<<"$have" || "${c[@]}" plugin marketplace add --scope user "${m#*=}"
  done
  have="$("${c[@]}" plugin list --json | jq -r '.[] | select(.scope == "user") | .id')"
  for p in "${plugins[@]}"; do
    grep -qxF "$p" <<<"$have" || "${c[@]}" plugin install --scope user "$p"
  done
  for s in "${mcp_servers[@]}"; do
    read -ra cmd <<<"${s#*=}"
    command -v "${cmd[0]}" &>/dev/null || continue
    "${c[@]}" mcp get "${s%%=*}" &>/dev/null || "${c[@]}" mcp add --scope user "${s%%=*}" -- "${cmd[@]}"
  done
done
